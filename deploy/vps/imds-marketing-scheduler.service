[Unit]
Description=IMDS Marketing scheduled jobs
After=network-online.target imds-marketing.service
Wants=network-online.target

[Service]
Type=simple
User=imds
Group=imds
WorkingDirectory=/opt/imds-marketing/current
EnvironmentFile=/etc/imds-marketing.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npx --yes tsx server/vpsScheduler.ts
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/imds-marketing

[Install]
WantedBy=multi-user.target
