[Unit]
Description=IMDS Marketing application runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=imds
Group=imds
WorkingDirectory=/opt/imds-marketing/current
EnvironmentFile=/etc/imds-marketing.env
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=IMDS_HOST=127.0.0.1
ExecStart=/usr/bin/npx --yes tsx server/vpsRuntime.ts
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/imds-marketing

[Install]
WantedBy=multi-user.target
