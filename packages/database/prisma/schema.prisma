generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
}

enum UserStatus {
  INVITED
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ChannelStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  CONTACT
  TEMPLATE
  SYSTEM
}

model Company {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String          @unique
  timezone    String          @default("Asia/Almaty")
  locale      String          @default("ru")
  currency    String          @default("KZT")
  settings    Json            @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  memberships CompanyMember[]
  auditLogs   AuditLog[]
  pipelines   Pipeline[]
  stages      PipelineStage[]
  deals       Deal[]
  whatsappChannels WhatsAppChannel[]
  conversations Conversation[]
  messages     Message[]
  webhookEvents WebhookEvent[]
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  avatarUrl    String?
  locale       String          @default("ru")
  status       UserStatus      @default(ACTIVE)
  lastActiveAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  memberships  CompanyMember[]
  sessions     AuthSession[]
  auditLogs    AuditLog[]
  ownedDeals   Deal[]           @relation("DealOwner")
  assignedConversations Conversation[] @relation("ConversationAssignee")
  sentMessages Message[] @relation("MessageSender")
}

model CompanyMember {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  userId      String    @db.Uuid
  role        UserRole  @default(MANAGER)
  department  String?
  jobTitle    String?
  permissions Json      @default("{}")
  joinedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId, role])
  @@index([userId])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  companyId        String    @db.Uuid
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId, userId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
}

model Pipeline {
  id        String          @id @default(uuid()) @db.Uuid
  companyId String          @db.Uuid
  name      String
  isDefault Boolean         @default(false)
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  deals     Deal[]

  @@unique([companyId, name])
  @@index([companyId, position])
}

model PipelineStage {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  pipelineId String   @db.Uuid
  name      String
  color     String    @default("#4F6EF7")
  position  Int       @default(0)
  isWon     Boolean   @default(false)
  isLost    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pipeline  Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals     Deal[]

  @@unique([pipelineId, name])
  @@index([companyId, pipelineId, position])
}

model Deal {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @db.Uuid
  pipelineId  String      @db.Uuid
  stageId     String      @db.Uuid
  ownerId     String?     @db.Uuid
  title       String
  contactName String?
  phone       String?
  email       String?
  amount      Decimal     @default(0) @db.Decimal(14, 2)
  status      DealStatus  @default(OPEN)
  source      String?
  position    Int         @default(0)
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pipeline    Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage       PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner       User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@index([companyId, pipelineId, stageId, position])
  @@index([companyId, ownerId])
  @@index([companyId, status, createdAt])
}

model WhatsAppChannel {
  id                  String        @id @default(uuid()) @db.Uuid
  companyId           String        @db.Uuid
  name                String
  phoneNumber         String?
  phoneNumberId       String?
  businessAccountId   String?
  configId            String?
  accessTokenEncrypted String?
  verifyTokenHash     String?
  status              ChannelStatus @default(DISCONNECTED)
  metadata            Json          @default("{}")
  lastSyncedAt        DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations       Conversation[]
  webhookEvents       WebhookEvent[]

  @@unique([companyId, phoneNumberId])
  @@index([companyId, status])
}

model Conversation {
  id            String             @id @default(uuid()) @db.Uuid
  companyId     String             @db.Uuid
  channelId     String             @db.Uuid
  dealId        String?            @db.Uuid
  assigneeId    String?            @db.Uuid
  externalChatId String
  contactPhone  String
  contactName   String?
  status        ConversationStatus @default(OPEN)
  unreadCount   Int                @default(0)
  lastMessageAt DateTime?
  metadata      Json               @default("{}")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  closedAt      DateTime?

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel       WhatsAppChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  deal          Deal?              @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assignee      User?              @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@unique([channelId, externalChatId])
  @@index([companyId, status, lastMessageAt])
  @@index([companyId, assigneeId])
  @@index([companyId, dealId])
}

model Message {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  conversationId  String           @db.Uuid
  senderUserId    String?          @db.Uuid
  externalMessageId String?
  direction       MessageDirection
  status          MessageStatus
  type            MessageType      @default(TEXT)
  text            String?
  mediaUrl        String?
  replyToMessageId String?
  metadata        Json             @default("{}")
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser      User?            @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, externalMessageId])
  @@index([companyId, conversationId, createdAt])
  @@index([companyId, status])
}

model WebhookEvent {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @db.Uuid
  channelId   String?         @db.Uuid
  provider    String
  externalId  String?
  eventType   String
  payload     Json
  processedAt DateTime?
  failedAt    DateTime?
  error       String?
  createdAt   DateTime        @default(now())

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel     WhatsAppChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([companyId, processedAt, createdAt])
  @@index([channelId, createdAt])
}
