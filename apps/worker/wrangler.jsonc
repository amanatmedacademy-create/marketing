{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imds-crm",
  "main": "src/entry.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/internal/*", "/health"]
  },
  "vars": {
    "APP_ENV": "production",
    "SUPABASE_URL": "https://kysdtmgijkffwtzugonv.supabase.co",
    "DEFAULT_COMPANY_ID": "4cd22020-6f1d-4afb-9266-b01c96e4a927"
  },
  "observability": {
    "enabled": true
  }
}
