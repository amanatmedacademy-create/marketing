    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.3",
    "recharts": "^2.15.4",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260727.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.26.0"
  }
}
