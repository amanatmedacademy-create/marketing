{
  "name": "imds-crm",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/worker typecheck",
    "build:all": "turbo build",
    "build:web": "bun run --cwd apps/web build",
    "build:worker": "bun run --cwd apps/worker typecheck",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @imds/database generate",
    "db:migrate": "pnpm --filter @imds/database migrate:dev",
    "db:seed": "pnpm --filter @imds/database seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.10.8",
    "typescript": "^5.9.3"
  }
}
